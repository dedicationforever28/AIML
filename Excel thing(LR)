import pandas as pd
import matplotlib.pyplot as plt
from sklearn.linear_model import LinearRegression
from sklearn.metrics import mean_squared_error, mean_absolute_error, r2_score
import numpy as np

# Load the dataset
df = pd.read_csv("C:/Users/dhyey/OneDrive/Desktop/10 Years (Surat).csv")
df.columns = ['Timestamp', 'WindSpeed']  # Rename columns
df.dropna(inplace=True)

# Use numeric index for regression
X = df.index.values.reshape(-1, 1)
y = df['WindSpeed'].values.reshape(-1, 1)

# Train Linear Regression model
model = LinearRegression()
model.fit(X, y)

# Predict wind speed
y_pred = model.predict(X)

# Evaluation Metrics
mae = mean_absolute_error(y, y_pred)
rmse = np.sqrt(mean_squared_error(y, y_pred))
r2 = r2_score(y, y_pred)

print("📈 Model Evaluation:")
print(f"➡️  MAE  (Mean Absolute Error):      {mae:.3f}")
print(f"➡️  RMSE (Root Mean Squared Error): {rmse:.3f}")
print(f"➡️  R² Score (Accuracy):            {r2:.3f}")

# ✅ Export Actual vs Predicted data to Excel
export_df = pd.DataFrame({
    'Timestamp': df['Timestamp'].values,
    'Actual Wind Speed': y.flatten(),
    'Predicted Wind Speed': y_pred.flatten()
})

export_df.to_excel("WindSpeed_Actual_vs_Predicted.xlsx", index=False)
print("✅ Excel file saved: WindSpeed_Actual_vs_Predicted.xlsx")


# ✅ Save plot as image
plt.savefig("WindSpeed_XGBoost_Plot.png", dpi=300)


# Plot
plt.figure(figsize=(12, 6))
plt.plot(y, label='Actual Wind Speed')
plt.plot(y_pred, label='Predicted Wind Speed', color='red')
plt.title("Wind Speed Prediction using Linear Regression")
plt.xlabel("Time Index")
plt.ylabel("Wind Speed")
plt.legend()
plt.grid(True)
plt.tight_layout()
plt.show()


