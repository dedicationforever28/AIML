import pandas as pd
import numpy as np
from sklearn.tree import DecisionTreeRegressor
from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score
import matplotlib.pyplot as plt

# Load data
file_path = "10 YEAR.csv"  # Replace with your file path
data = pd.read_csv(file_path)

# Extract data
time = np.arange(len(data))  # Use index as time
irradiance = data['Irradiance GHI from weather file | (W/m2)'].values

# Train Decision Tree model
model = DecisionTreeRegressor(max_depth=10, random_state=42)
model.fit(time.reshape(-1, 1), irradiance)

# Predict on training data
train_pred = model.predict(time.reshape(-1, 1))

# Metrics
mae = mean_absolute_error(irradiance, train_pred)
rmse = np.sqrt(mean_squared_error(irradiance, train_pred))
r2 = r2_score(irradiance, train_pred)

# Predict next 10 years (future timestamps)
future_time = np.arange(len(data), len(data) + len(data))  # Next 10 years (same length as original)
future_pred = model.predict(future_time.reshape(-1, 1))

# Save results in a DataFrame
results = pd.DataFrame({
    "Time": np.concatenate([time, future_time]),
    "Irradiance (W/m²)": np.concatenate([irradiance, [np.nan] * len(future_pred)]),
    "Prediction (W/m²)": np.concatenate([train_pred, future_pred])
})

# Save to Excel
excel_path = "decision_tree_irradiance_prediction.xlsx"
results.to_excel(excel_path, index=False)

# Plot graph
plt.figure(figsize=(12, 6))
plt.plot(time, irradiance, label='Actual (10 years)', color='blue', alpha=0.7)
plt.plot(time, train_pred, label='Model Fit', color='green')
plt.plot(future_time, future_pred, label='Predicted Next 10 Years', color='red', linestyle='--')
plt.title('Decision Tree Prediction of Irradiance (10 Years -> Next 10 Years)')
plt.xlabel('Time')
plt.ylabel('Irradiance (W/m²)')
plt.legend()
plt.grid(True)
plt.tight_layout()
plt.savefig("decision_tree_irradiance_plot.png")
plt.show()

# Print metrics
print(f"MAE: {mae:.4f}")
print(f"RMSE: {rmse:.4f}")
print(f"R² Score: {r2:.4f}")
print(f"Results saved to: {excel_path}")
